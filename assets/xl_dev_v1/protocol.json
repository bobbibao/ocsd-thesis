 "decision_rule": {
  "candidates": [
   "ocsd_xl",
   "ocsd_xl_a02",
   "ocsd_xl_a06",
   "ocsd_xl_w04",
   "ocsd_xl_noenergy",
   "ocsd_xl_sep",
   "ocsd_xl_id"
  ],
  "ablations_only": [
   "ocsd_xl_norepair",
   "ocsd_xl_region"
  ],
  "baselines": [
   "xl_controlnet",
   "xl_collage"
  ],
  "structure": "S = mean over scenes of (OPR + mIoU) / 2, OWLv2, seeds averaged",
  "naturalness": "N = mean blind rating (0 broken or pasted, 1 fake but readable, 2 natural) over the 18 sheets, written by the analyst before opening review_key.json",
  "steps": [
   "1. A candidate must have all 18 images.",
   "2. Admissible: N >= 1.0 and S >= (best S among candidates) - 0.03.",
   "3. Choose the admissible candidate with the highest N; within 0.1 of N prefer the lower sketch chamfer, then the lower time per image.",
   "4. Go to confirmation only if the chosen arm has S >= S of xl_controlnet (same backbone and ControlNet); otherwise report that M2-M5 add nothing on SDXL.",
   "5. If no candidate is admissible, nothing is frozen; the next development round uses the held-out v2 scenes."
  ],
  "note": "PickScore, CLIP, count accuracy, relations and facing are reported but do not enter the rule."
 },
 "confirmation_plan": "Frozen OCSD-XL vs original OCSD (v1), OCSD-v2, GLIGEN, Collage, ControlNet (SD 1.5), InstanceDiffusion and the SDXL baselines on the 18 held-out v3 scenes and the 72 paper scenes; protocol locked in a separate file before that run."
